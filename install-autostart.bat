@echo off
chcp 65001 >nul
cd /d "%~dp0"
title Movo autostart install

rem ------------------------------------------------------------
rem  Writes a tiny wrapper vbs into the Startup folder.
rem  The wrapper launches start-hidden.vbs in THIS folder by
rem  absolute path, so the folder must not be moved afterwards.
rem  If you move the folder, run this script again.
rem ------------------------------------------------------------

set "TARGET=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\Movo.vbs"
set "PROJ=%~dp0"

if not exist "%PROJ%start-hidden.vbs" goto missing

> "%TARGET%" echo ' Movo autostart wrapper - generated by install-autostart.bat
>> "%TARGET%" echo ' If the Movo folder is moved, run install-autostart.bat again.
>> "%TARGET%" echo Option Explicit
>> "%TARGET%" echo CreateObject("WScript.Shell"^).Run "wscript.exe ""%PROJ%start-hidden.vbs""", 0, False

if errorlevel 1 goto failed

echo.
echo   OK - autostart installed, no admin needed.
echo.
echo   Startup item : %TARGET%
echo   Project path : %PROJ%
echo.
echo   IMPORTANT: the project path is baked into the startup item.
echo   If you move the Movo folder, run install-autostart.bat again.
echo.
echo   Starting the server now ...
start "" wscript.exe "%PROJ%start-hidden.vbs"
ping -n 4 127.0.0.1 >nul
echo   Done. On the phone open the address shown by start-movo.bat.
ping -n 4 127.0.0.1 >nul
exit /b 0

:missing
echo   start-hidden.vbs not found in this folder.
pause
exit /b 1

:failed
echo   Could not write the startup item. Check permissions.
pause
exit /b 1
